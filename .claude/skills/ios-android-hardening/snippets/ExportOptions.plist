<?xml version="1.0" encoding="UTF-8"?>
<!-- ios/ExportOptions.plist
     Used by `flutter build ipa --export-options-plist=ios/ExportOptions.plist`.
     Adjust signingStyle and provisioningProfiles for your team.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store</string>

  <key>destination</key>
  <string>upload</string>

  <!-- Symbol upload to Crashlytics / Sentry happens via Fastlane post-build hook -->
  <key>uploadSymbols</key>
  <true/>

  <!-- Stripping: All Symbols. Mirror in Xcode Build Settings → Release. -->
  <key>stripSwiftSymbols</key>
  <true/>

  <!-- Bitcode is dead since Xcode 14 — keep false -->
  <key>uploadBitcode</key>
  <false/>

  <key>signingStyle</key>
  <string>automatic</string>
  <!-- For manual: change to "manual" + add provisioningProfiles dict -->

  <key>teamID</key>
  <string>YOUR_TEAM_ID</string>
</dict>
</plist>
