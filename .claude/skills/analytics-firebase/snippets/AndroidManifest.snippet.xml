<!--
  Add inside <application> in android/app/src/main/AndroidManifest.xml.
  Default-DENIES all 4 Consent Mode v2 flags. ConsentService.apply() flips
  them after explicit user acceptance.
-->

<meta-data
    android:name="google_analytics_default_allow_analytics_storage"
    android:value="false"/>
<meta-data
    android:name="google_analytics_default_allow_ad_storage"
    android:value="false"/>
<meta-data
    android:name="google_analytics_default_allow_ad_user_data"
    android:value="false"/>
<meta-data
    android:name="google_analytics_default_allow_ad_personalization_signals"
    android:value="false"/>
