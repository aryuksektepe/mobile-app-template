{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter pub upgrade)",
      "Bash(flutter pub outdated)",
      "Bash(flutter pub deps)",
      "Bash(flutter pub run build_runner:*)",
      "Bash(flutter analyze)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test)",
      "Bash(flutter test:*)",
      "Bash(flutter doctor)",
      "Bash(flutter doctor:*)",
      "Bash(flutter devices)",
      "Bash(flutter --version)",
      "Bash(flutter gen-l10n)",
      "Bash(flutter gen-l10n:*)",
      "Bash(flutter format:*)",
      "Bash(flutter create:*)",
      "Bash(dart --version)",
      "Bash(dart format:*)",
      "Bash(dart analyze)",
      "Bash(dart analyze:*)",
      "Bash(dart fix:*)",
      "Bash(dart pub:*)",
      "Bash(dart run:*)",
      "Bash(dart test:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git remote:*)",
      "Bash(git config --get:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git reset --soft:*)",
      "Bash(git reset --mixed:*)",
      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh api:*)",
      "Bash(gh release list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(env)",
      "Bash(date)",
      "Bash(date:*)",
      "Bash(python3 --version)",
      "Bash(python3:*)",
      "Bash(pod --version)",
      "Bash(pod install)",
      "Bash(pod install:*)",
      "Bash(pod update:*)",
      "Bash(pod repo:*)",
      "Bash(xcodebuild -version)",
      "Bash(xcodebuild -showsdks)",
      "Bash(xcrun simctl list:*)",
      "Bash(adb devices)",
      "Bash(adb logcat:*)",
      "Bash(adb shell:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew --version)",
      "Bash(./gradlew tasks:*)",
      "Bash(./gradlew lint:*)",
      "Bash(fastlane --version)",
      "Bash(fastlane lanes:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm list:*)",
      "Bash(npm outdated:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:revenuecat.com)",
      "WebFetch(domain:docs.revenuecat.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:mas.owasp.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(flutter clean)",
      "Bash(rm -rf node_modules:*)",
      "Bash(rm -rf .git:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)"
    ],
    "ask": [
      "Bash(flutter build:*)",
      "Bash(flutter run:*)",
      "Bash(flutter install:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm:*)",
      "Bash(npm install:*)",
      "Bash(pod deintegrate:*)",
      "Bash(fastlane:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-phase-state.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-phase-state.py\""
          }
        ]
      }
    ]
  },
  "env": {
    "FLUTTER_CLI_NO_COLOR": "false"
  }
}
